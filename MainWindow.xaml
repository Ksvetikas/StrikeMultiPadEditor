
<Window x:Class="StrikeMultiPadEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strike MultiPad Editor"
        Height="850" Width="1450"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#11151B"
        Foreground="#E8EDF4">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1A2029"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="#222B37"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#E04444"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8995A5"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#293342"/>
            <Setter Property="Foreground" Value="#F3F5F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111720"/>
            <Setter Property="Foreground" Value="#F3F5F8"/>
            <Setter Property="BorderBrush" Value="#354151"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1A2029"/>
            <Setter Property="Foreground" Value="#E8EDF4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#1A2029"/>
            <Setter Property="AlternatingRowBackground" Value="#202834"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#252E3A"/>
            <Setter Property="Foreground" Value="#AEB9C8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0"
                Background="#191F28"
                BorderBrush="#303A48"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="38" Height="38"
                            Background="#E04444"
                            CornerRadius="8"
                            VerticalAlignment="Center">
                        <TextBlock Text="S"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="STRIKE MULTIPAD"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="KIT EDITOR"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#E04444"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="OPEN BACKUP"
                            Background="#E04444"
                            Click="OpenBackup_Click"/>
                    <Button Content="EXTRACT SELECTED KIT"
                            Click="ExtractKit_Click"/>
                    <Button Content="COPY ALL LAYER DATA"
                            Click="CopyAllLayerData_Click"
                            HorizontalAlignment="Left"
                            Padding="14,7"
                            Margin="0,0,0,10"/>
                    <Button Content="COPY SAMPLE REFERENCE SCAN"
                            Click="CopySampleReferenceScan_Click"
                            Margin="4"
                            Padding="10,6"/>
                    <Button Content="COPY SAMPLE REFERENCE RESULTS"
                            Click="CopySampleReferenceResults_Click"
                            Margin="4"
                            Padding="10,6"/>
                    <Button x:Name="ExportAnalysisPackageButton"
                            Content="EXPORT ANALYSIS PACKAGE"
                            Click="ExportAnalysisPackage_Click"
                            Background="#3A6B87"
                            Margin="4"
                            Padding="10,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- KIT BROWSER -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="9"
                    Margin="0,0,7,0"
                    Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="KIT LIBRARY"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock x:Name="KitCountText"
                                   Text="0 kits loaded"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,5,0,13"
                                   FontSize="11"/>

                        <TextBox x:Name="SearchBox"
                                 Height="36"
                                 ToolTip="Search kits by name"
                                 TextChanged="SearchBox_TextChanged"/>

                        <TextBlock Text="YOUR KITS"
                                   Margin="0,18,0,8"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#8995A5"/>
                    </StackPanel>

                    <DataGrid x:Name="KitGrid"
                              SelectionChanged="KitGrid_SelectionChanged"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="KIT NAME"
                                                Binding="{Binding FileName}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- PAD WORKSPACE -->
            <Border Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="12"
                    Padding="18"
                    Margin="0,0,12,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="SelectedKitName"
                                   Text="No kit selected"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="SelectedKitSubtext"
                                   Text="Select a kit from the library"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,18"/>

                        <TextBlock Text="HARDWARE LAYOUT"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Select a physical position to inspect"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,18"/>

                        <TextBlock Text="SAMPLE PADS"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <UniformGrid Columns="3" Rows="3">

                            <Button Content="PAD 1" Tag="Pad 1"
                                    Click="HardwarePosition_Click"
                                    Margin="4" Height="95"/>

                            <Button Content="PAD 2" Tag="Pad 2"
                                    Click="HardwarePosition_Click"
                                    Margin="4" Height="95"/>

                            <Button Content="PAD 3" Tag="Pad 3"
                                    Click="HardwarePosition_Click"
                                    Margin="4" Height="95"/>

                            <Button Content="PAD 4" Tag="Pad 4"
                                    Click="HardwarePosition_Click"
                                    Margin="4" Height="95"/>

                            <Button Content="PAD 5" Tag="Pad 5"
                                    Click="HardwarePosition_Click"
                                    Margin="4" Height="95"/>

                            <Button Content="PAD 6" Tag="Pad 6"
                                    Click="HardwarePosition_Click"
                                    Margin="4" Height="95"/>

                            <Button Content="PAD 7" Tag="Pad 7"
                                    Click="HardwarePosition_Click"
                                    Margin="4" Height="95"/>

                            <Button Content="PAD 8" Tag="Pad 8"
                                    Click="HardwarePosition_Click"
                                    Margin="4" Height="95"/>

                            <Button Content="PAD 9" Tag="Pad 9"
                                    Click="HardwarePosition_Click"
                                    Margin="4" Height="95"/>

                        </UniformGrid>

                        <TextBlock Text="TRIGGER INPUTS"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,22,0,10"/>

                        <UniformGrid Columns="3">

                            <Button Content="HH" Tag="HH"
                                    Click="HardwarePosition_Click"
                                    Margin="4" Height="48"/>

                            <Button Content="TRIGGER 1" Tag="Trigger In 1"
                                    Click="HardwarePosition_Click"
                                    Margin="4" Height="48"/>

                            <Button Content="TRIGGER 2" Tag="Trigger In 2"
                                    Click="HardwarePosition_Click"
                                    Margin="4" Height="48"/>

                            <Button Content="TRIGGER 3" Tag="Trigger In 3"
                                    Click="HardwarePosition_Click"
                                    Margin="4" Height="48"/>

                            <Button Content="TRIGGER 4" Tag="Trigger In 4"
                                    Click="HardwarePosition_Click"
                                    Margin="4" Height="48"/>

                            <Button Content="TRIGGER 5" Tag="Trigger In 5"
                                    Click="HardwarePosition_Click"
                                    Margin="4" Height="48"/>

                        </UniformGrid>

                        <TextBlock Text="FOOT CONTROLS"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,22,0,10"/>

                        <UniformGrid Columns="4">

                            <Button Content="FOOT 1" Tag="Foot CTRL 1"
                                    Click="HardwarePosition_Click"
                                    Margin="4" Height="48"/>

                            <Button Content="FOOT 2" Tag="Foot CTRL 2"
                                    Click="HardwarePosition_Click"
                                    Margin="4" Height="48"/>

                            <Button Content="FOOT 3" Tag="Foot CTRL 3"
                                    Click="HardwarePosition_Click"
                                    Margin="4" Height="48"/>

                            <Button Content="FOOT 4" Tag="Foot CTRL 4"
                                    Click="HardwarePosition_Click"
                                    Margin="4" Height="48"/>

                        </UniformGrid>

                        
                        <Border Background="#222B37"
                                BorderBrush="#354151"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="4,18,4,8">

                            <StackPanel>
                                <TextBlock Text="PAD PARAMETERS"
                                           Foreground="White"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Margin="0,0,0,5"/>

                                <TextBlock x:Name="PadParameterStatusText"
                                           Text="Select a kit and a physical pad"
                                           Foreground="#E0B45C"
                                           FontSize="11"
                                           Margin="0,0,0,14"/>

                                <TextBlock x:Name="PadParameterTitle"
                                           Text="No pad selected"
                                           Foreground="White"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- PAD RESPONSE -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="PAD RESPONSE"
                                                   Foreground="#E04444"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   Margin="0,0,0,10"/>

                                        <TextBlock Text="Sensitivity"
                                                   Foreground="#8995A5"/>
                                        <TextBlock x:Name="PadSensitivityText"
                                                   Text="Not decoded"
                                                   Foreground="White"
                                                   Margin="0,2,0,8"/>

                                        <TextBlock Text="Curve"
                                                   Foreground="#8995A5"/>
                                        <TextBlock x:Name="PadCurveText"
                                                   Text="Not decoded"
                                                   Foreground="White"
                                                   Margin="0,2,0,8"/>

                                        <TextBlock Text="Threshold"
                                                   Foreground="#8995A5"/>
                                        <TextBlock x:Name="PadThresholdText"
                                                   Text="Not decoded"
                                                   Foreground="White"
                                                   Margin="0,2,0,8"/>

                                        <TextBlock Text="Fixed Level"
                                                   Foreground="#8995A5"/>
                                        <TextBlock x:Name="PadFixedLevelText"
                                                   Text="Not decoded"
                                                   Foreground="White"
                                                   Margin="0,2,0,8"/>
                                    </StackPanel>

                                    <!-- WAVE A -->
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock Text="WAVE A"
                                                   Foreground="#E04444"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   Margin="0,0,0,10"/>

                                        <TextBlock Text="Sample"
                                                   Foreground="#8995A5"/>
                                        <TextBlock x:Name="WaveASampleText"
                                                   Text="Not decoded"
                                                   Foreground="White"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,8"/>

                                        <TextBlock Text="Volume"
                                                   Foreground="#8995A5"/>
                                        <TextBlock x:Name="WaveAVolumeText"
                                                   Text="Not decoded"
                                                   Foreground="White"
                                                   Margin="0,2,0,8"/>

                                        <TextBlock Text="Pan"
                                                   Foreground="#8995A5"/>
                                        <TextBlock x:Name="WaveAPanText"
                                                   Text="Not decoded"
                                                   Foreground="White"
                                                   Margin="0,2,0,8"/>

                                        <TextBlock Text="Playback"
                                                   Foreground="#8995A5"/>
                                        <TextBlock x:Name="WaveAPlaybackText"
                                                   Text="Not decoded"
                                                   Foreground="White"
                                                   Margin="0,2,0,8"/>
                                    </StackPanel>

                                    <!-- WAVE B -->
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="WAVE B"
                                                   Foreground="#E04444"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   Margin="0,0,0,10"/>

                                        <TextBlock Text="Sample"
                                                   Foreground="#8995A5"/>
                                        <TextBlock x:Name="WaveBSampleText"
                                                   Text="Not decoded"
                                                   Foreground="White"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,8"/>

                                        <TextBlock Text="Volume"
                                                   Foreground="#8995A5"/>
                                        <TextBlock x:Name="WaveBVolumeText"
                                                   Text="Not decoded"
                                                   Foreground="White"
                                                   Margin="0,2,0,8"/>

                                        <TextBlock Text="Pan"
                                                   Foreground="#8995A5"/>
                                        <TextBlock x:Name="WaveBPanText"
                                                   Text="Not decoded"
                                                   Foreground="White"
                                                   Margin="0,2,0,8"/>

                                        <TextBlock Text="Playback"
                                                   Foreground="#8995A5"/>
                                        <TextBlock x:Name="WaveBPlaybackText"
                                                   Text="Not decoded"
                                                   Foreground="White"
                                                   Margin="0,2,0,8"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,8,0,8">

                            <StackPanel>
                                <TextBlock Text="CANDIDATE SOUND LAYERS"
                                           Foreground="White"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>

                                <TextBlock Text="Raw fields extracted from each KITI record. A/B assignments are provisional."
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <DataGrid x:Name="CandidateLayerGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          Background="{StaticResource PanelLightBrush}"
                                          Foreground="White"
                                          RowBackground="{StaticResource PanelLightBrush}"
                                          AlternatingRowBackground="{StaticResource PanelBrush}"
                                          BorderThickness="0"
                                          MinHeight="180"
                                          MaxHeight="420">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="KITI #"
                                            Binding="{Binding RecordNumber}"/>

                                        <DataGridTextColumn Header="Layer"
                                            Binding="{Binding LayerName}"/>

                                        <DataGridTextColumn Header="Sample Ref (candidate)"
                                            Binding="{Binding SampleReference}"/>

                                        <DataGridTextColumn Header="Sample Name (backup)"
                                            Binding="{Binding SampleName}"
                                            Width="*"/>

                                        <DataGridTextColumn Header="Velocity Range (candidate)"
                                            Binding="{Binding VelocityRangeText}"/>

                                        <DataGridTextColumn Header="Byte +09 (unidentified)"
                                            Binding="{Binding CandidateByte09}"/>

                                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding AssignmentStatus}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- KIT INSPECTOR -->
            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="9"
                    Margin="7,0,0,0"
                    Padding="16">
                
        		<Grid>
        		    <Grid.RowDefinitions>
        		        <RowDefinition Height="Auto"/>
        		        <RowDefinition Height="Auto"/>
        		        <RowDefinition Height="Auto"/>
        		        <RowDefinition Height="Auto"/>
        		        <RowDefinition Height="Auto"/>
        		        <RowDefinition Height="2*"/>
                        <RowDefinition Height="3*"/>
        		    </Grid.RowDefinitions>

        		    <TextBlock Text="KIT INSPECTOR"
        		               FontSize="13"
        		               FontWeight="Bold"
        		               Foreground="White"
        		               Margin="0,0,0,18"/>

        		    <StackPanel Grid.Row="1">
        		        <TextBlock Text="SELECTED KIT"
        		                   FontSize="10"
        		                   FontWeight="Bold"
                           Foreground="#8995A5"/>

                        <TextBlock x:Name="InspectorKitName"
                                   Text="—"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,14"/>
                        <TextBlock Text="SELECTED HARDWARE POSITION"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   Margin="0,16,0,5"/>

                        <TextBlock x:Name="SelectedPositionName"
                                   Text="None selected"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="SelectedPositionType"
                                   Text="Choose a pad or input"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,12"/>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="FILE TYPE"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#8995A5"/>
                            <TextBlock x:Name="KitTypeText"
                                       Text="—"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="BACKUP OFFSET"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#8995A5"/>
                            <TextBlock x:Name="KitOffsetText"
                                       Text="—"
                                       Margin="0,5,0,0"/>
                        </StackPanel> 
                    </Grid>

        		    <Border Grid.Row="3"
        		            Height="1"
        		            Background="#303A48"
        		            Margin="0,0,0,14"/>
        		   
        		</Grid>
	        </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2"
                Background="#191F28"
                BorderBrush="#303A48"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock x:Name="StatusText"
                           Text="Ready — open a Strike backup to get started"
                           Foreground="#AEB9C8"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
